{
    "name": "gtosss/b24-php-webhook-test-task",
    "description": "Bitrix24 incoming webhook PHP script",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "bitrix24/b24phpsdk": "^1.7",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "B24Webhook\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
